{
  "manifest_version": 3,
  "name": "Gmail AutoFill",
  "version": "2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Автоматически находит поля для ввода кодов на сайтах и достает код из Gmail.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gmail-code-extractor@anix.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["global.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Настройки извлечения кодов"
  }
}
